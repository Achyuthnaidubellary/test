# Terraform output file - ignored by git
terraform-output.txt

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfvars example files
!*.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform provider plugins
.terraform/
.terraform.lock.hcl
